; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Idle Pioneer"
config/version="0.9.0"
config/description="An idle colonial trade game: found colonies, ship goods to Europe, craft finer wares, and declare independence."
run/main_scene="res://scenes/Main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.086, 0.114, 0.2, 1)
boot_splash/show_image=false
config/icon="res://assets/sprites/app_icon.png"

[autoload]

Content="*res://scripts/core/content.gd"
Balance="*res://scripts/core/balance.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"
Platform="*res://scripts/core/platform.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Idle Pioneer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.086, 0.114, 0.2, 1)
