	"relics": [
		{"id": "kite_key", "set": "franklin", "name": "Franklin's Kite Key", "year": 1752, "effect": "craft_speed", "value": 1.05, "desc": "Workshop speed +5%", "lore": "A house key tied where the hemp kite string met a silk ribbon. As a storm passed over Philadelphia in 1752, sparks leapt from it to Franklin's knuckle."},
		{"id": "franklin_stove", "set": "franklin", "name": "Pennsylvania Fireplace", "year": 1742, "effect": "colonist_cost", "value": 0.95, "desc": "Colonists cost 5% less", "lore": "Franklin's iron stove threw more heat into the room on less wood. He refused a patent so that anyone could make one."},
		{"id": "armonica", "set": "franklin", "name": "Glass Armonica", "year": 1761, "effect": "sell_price", "value": 1.03, "desc": "Sale prices +3%", "lore": "Nested glass bowls turned on a spindle and played with wet fingers. Mozart and Beethoven both wrote for it."},
		{"id": "bifocals", "set": "franklin", "name": "Double Spectacles", "year": 1784, "effect": "explore", "value": 1.05, "desc": "Scouts see 5% farther", "lore": "Tired of swapping two pairs of glasses, Franklin had the lenses cut in half and joined in one frame."},
		{"id": "poor_richard", "set": "franklin", "name": "Poor Richard's Almanack", "year": 1732, "effect": "offline_hours", "value": 0.5, "desc": "+30 min offline earnings", "lore": "Weather, tides and proverbs, printed every year for a quarter century. 'Early to bed and early to rise...'"},
		{"id": "revere_lantern", "set": "revolution", "name": "Old North Church Lantern", "year": 1775, "effect": "land_speed", "value": 1.05, "desc": "Wagons 5% faster", "lore": "'One if by land, two if by sea,' Longfellow wrote later. Two lanterns in the steeple told Charlestown the regulars were crossing the river by boat."},
		{"id": "tea_chest", "set": "revolution", "name": "Tea Chest from Griffin's Wharf", "year": 1773, "effect": "sell_price", "value": 1.03, "desc": "Sale prices +3%", "lore": "More than three hundred and forty chests went into Boston Harbor that December night. Next morning a boy found one on the Dorchester shore and kept it."},
		{"id": "syng_inkstand", "set": "revolution", "name": "Syng Inkstand", "year": 1752, "effect": "liberty", "value": 1.05, "desc": "Liberty +5%", "lore": "Philip Syng's silver inkstand held the ink for the signing of the Declaration of Independence and, later, the Constitution."},
		{"id": "common_sense", "set": "revolution", "name": "Common Sense, First Printing", "year": 1776, "effect": "liberty", "value": 1.05, "desc": "Liberty +5%", "lore": "Thomas Paine's pamphlet sold in Philadelphia for two shillings in January 1776. Within months, tens of thousands of copies were printed across the colonies."},
		{"id": "knox_cannon", "set": "revolution", "name": "Cannon of the Noble Train", "year": 1776, "effect": "production", "value": 1.05, "desc": "Production +5%", "lore": "Henry Knox hauled some sixty tons of guns from Fort Ticonderoga to Boston on sleds drawn by oxen and horses, in winter, over the Berkshires."},
		{"id": "mason_dixon", "set": "scholars", "name": "Mason and Dixon's Transit", "year": 1763, "effect": "colony_cost", "value": 0.95, "desc": "Colonies cost 5% less", "lore": "An English astronomer and a surveyor spent four years sighting stars to fix the boundary between Pennsylvania and Maryland."},
		{"id": "orrery", "set": "scholars", "name": "Rittenhouse Orrery", "year": 1767, "effect": "craft_speed", "value": 1.05, "desc": "Workshop speed +5%", "lore": "David Rittenhouse's clockwork model of the heavens could show the planets' positions for any date across some five thousand years."},
		{"id": "chronometer", "set": "scholars", "name": "Harrison's Sea Watch", "year": 1761, "effect": "sea_speed", "value": 1.05, "desc": "Ships 5% faster", "lore": "John Harrison's H4 kept time within seconds across the Atlantic, finally letting navigators find their longitude."},
		{"id": "franklinia", "set": "scholars", "name": "Bartram's Franklinia Seeds", "year": 1765, "effect": "production", "value": 1.05, "desc": "Production +5%", "lore": "John and William Bartram found a flowering tree on Georgia's Altamaha River; William later named it for Franklin. It has not been seen in the wild since 1803."},
		{"id": "banneker_almanac", "set": "scholars", "name": "Banneker's Almanac", "year": 1792, "effect": "offline_hours", "value": 0.5, "desc": "+30 min offline earnings", "lore": "Benjamin Banneker calculated its ephemeris himself, and in 1791 sent the manuscript to Thomas Jefferson with a letter against slavery."},
		{"id": "mayflower_compact", "set": "settlements", "name": "The Mayflower Compact", "year": 1620, "effect": "colony_cost", "value": 0.95, "desc": "Colonies cost 5% less", "lore": "Signed aboard ship off Cape Cod by forty-one men, who agreed to govern themselves by just and equal laws."},
		{"id": "bay_psalm", "set": "settlements", "name": "Bay Psalm Book", "year": 1640, "effect": "colonist_cost", "value": 0.95, "desc": "Colonists cost 5% less", "lore": "The first book printed in British North America, on a press in Cambridge, Massachusetts."},
		{"id": "pine_tree_shilling", "set": "settlements", "name": "Pine Tree Shilling", "year": 1667, "effect": "treasure", "value": 1.1, "desc": "Treasure +10%", "lore": "Massachusetts coined its own silver without royal leave. The pine tree design was struck from 1667 to 1682, yet every coin still bore the date 1652."},
		{"id": "new_england_primer", "set": "settlements", "name": "The New England Primer", "year": 1690, "effect": "explore", "value": 1.05, "desc": "Scouts see 5% farther", "lore": "'In Adam's fall, we sinned all.' Generations of colonial children learned their letters from its rhymes and woodcuts."},
		{"id": "coquina_stone", "set": "settlements", "name": "Coquina Block of San Marcos", "year": 1672, "effect": "cargo", "value": 1.05, "desc": "Cargo +5%", "lore": "The Spanish fort at St. Augustine was built of shell-stone that swallowed cannonballs instead of shattering."},
		{"id": "long_rifle", "set": "frontier", "name": "Pennsylvania Long Rifle", "year": 1740, "effect": "production", "value": 1.05, "desc": "Production +5%", "lore": "German gunsmiths in Lancaster County rifled long barrels for frontier hunters. It later became known as the Kentucky rifle."},
		{"id": "conestoga_wheel", "set": "frontier", "name": "Conestoga Wagon Wheel", "year": 1750, "effect": "land_speed", "value": 1.05, "desc": "Wagons 5% faster", "lore": "Built in the Conestoga valley with a curved bed so loads wouldn't shift on the hills, pulled by teams of four to six horses."},
		{"id": "point_blanket", "set": "frontier", "name": "Point Blanket", "year": 1780, "effect": "sell_price", "value": 1.03, "desc": "Sale prices +3%", "lore": "Wool trade blankets woven in England, with short stripes, or 'points', along the edge marking their size."},
		{"id": "grasshopper_vane", "set": "frontier", "name": "Faneuil Hall Grasshopper", "year": 1742, "effect": "treasure", "value": 1.1, "desc": "Treasure +10%", "lore": "Shem Drowne's gilded copper weathervane still turns above Boston's market hall."},
		{"id": "revere_teapot", "set": "frontier", "name": "Revere Silver Teapot", "year": 1782, "effect": "crafted_price", "value": 1.05, "desc": "Crafted goods sell +5%", "lore": "Before and after his famous ride, Paul Revere was first of all a silversmith, and a very good one."},
		{"id": "octant", "set": "maritime", "name": "Hadley's Octant", "year": 1731, "effect": "sea_speed", "value": 1.05, "desc": "Ships 5% faster", "lore": "Two mirrors let a navigator bring the sun down to the horizon on a rolling deck. Thomas Godfrey of Philadelphia invented one at the same time."},
		{"id": "bill_of_lading", "set": "maritime", "name": "Bill of Lading", "year": 1765, "effect": "sell_price", "value": 1.03, "desc": "Sale prices +3%", "lore": "Printed forms began 'Shipped by the Grace of God in good order and well conditioned,' then named the ship, her master, the cargo and the port bound for."},
		{"id": "letter_of_marque", "set": "maritime", "name": "Letter of Marque", "year": 1776, "effect": "treasure", "value": 1.1, "desc": "Treasure +10%", "lore": "Congress licensed private ships to take enemy merchantmen. Privateers captured far more prizes than the Continental Navy."},
		{"id": "try_pot", "set": "maritime", "name": "Whaler's Try-Pot", "year": 1760, "effect": "production", "value": 1.05, "desc": "Production +5%", "lore": "Iron cauldrons set in a brick furnace on deck, where whale blubber was boiled down into oil far out at sea."},
		{"id": "atlantic_neptune", "set": "maritime", "name": "The Atlantic Neptune", "year": 1777, "effect": "cargo", "value": 1.05, "desc": "Cargo +5%", "lore": "J.F.W. Des Barres spent a decade surveying Nova Scotia's coast, then gathered charts of the whole seaboard. Sailors relied on them for fifty years."}
	],
